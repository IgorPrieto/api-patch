{
  "name": "apipatch",
  "version": "0.1.0-beta.2",
  "private": false,
  "description": "Local OpenAPI change analysis and verifiable consumer patches",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IgorPrieto/api-patch.git"
  },
  "homepage": "https://github.com/IgorPrieto/api-patch#readme",
  "bugs": "https://github.com/IgorPrieto/api-patch/issues",
  "keywords": [
    "openapi",
    "api-migration",
    "breaking-changes",
    "typescript",
    "codemod"
  ],
  "type": "module",
  "bin": {
    "apipatch": "./dist/cli/main.js"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "src",
    "demo",
    "docs",
    "examples",
    "README.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "commander": "15.0.0",
    "diff": "9.0.0",
    "typescript": "6.0.3",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "vitest": "5.0.3"
  }
}
